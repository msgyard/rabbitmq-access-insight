{erl_opts, [debug_info]}.
%% rabbit_common supplies the #event record and the log domain, both unchanged
%% across 3.12-4.3. This is a local-build default; the real builds and CI use
%% build-ez.sh / run-tests.sh against each supported RabbitMQ release.
{deps, [{rabbit_common, "3.12.14"}]}.
